<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelExpenseTracker.Pages.TripsPage"
             xmlns:model="clr-namespace:TravelExpenseTracker.Models"
             xmlns:vm="clr-namespace:TravelExpenseTracker.ViewModels"
             Title="Trips"
             BackgroundColor="#FFF7ECEC"
             x:DataType="vm:TripsViewModel">
            <ContentPage.ToolbarItems>
                <ToolbarItem IconImageSource="plus.png" Command="{Binding AddTripTempCommand}"/>
            </ContentPage.ToolbarItems>




            <CollectionView Margin="15" ItemsSource="{Binding Trips}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout 
                            HorizontalOptions="Center"
                            Spacing="10" 
                            Padding="25" 
                            Margin="0, 300, 0, 0">
                            <Label Text="No trips yet" FontSize="25" TextColor="DarkGray"/>
                            <Button
                            Command="{Binding AddTripTempCommand}" 
                            Text="+Add a Trip" 
                            VerticalOptions="Start"
                            Style="{StaticResource btnSm}"
                            HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="15" Orientation="Vertical"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:TripModel">
                            <Border BackgroundColor="White"
                                StrokeShape="RoundRectangle 15"
                                Padding="10"
                                StrokeThickness="0"> 
                                <Grid ColumnDefinitions="120, 1, *" ColumnSpacing="6">
                                    <Image Source="{Binding Image}" 
                                        Grid.Column="0"
                                        WidthRequest="120"/>
                                    <BoxView 
                                        Grid.Column="1" 
                                        WidthRequest="0.5"
                                        BackgroundColor="LightGray"/>
                                    <Grid
                                        Grid.Column="2" 
                                        RowDefinitions="Auto, *, Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                        <Label 
                                            Grid.Column="0"
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            Text="{Binding Title}"/>
                                        <Border Grid.Column="1" 
                                            BackgroundColor="Green"
                                            HeightRequest="20"
                                            StrokeShape="RoundRectangle 10"
                                            StrokeThickness="0"
                                            Padding="10, 2">
                                            <Label Text="Planned" TextColor="White" FontSize="10"/>
                                        </Border>   
                                        </Grid>
                                        <HorizontalStackLayout Grid.Row="1" Spacing="3">
                                            <Image Source="map.png" HeightRequest="16" VerticalOptions="Center"/>

                                        <Label
                                            Text="{Binding Location}"
                                            VerticalOptions="Center"/>
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Grid.Row="2" Spacing="3">
                                            <Image Source="calendar.png" HeightRequest="16" VerticalOptions="Center"/>
                                            <Label Grid.Row="2" Text="04-10-2026 - 05-10-2025" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        

                                    </Grid>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
            </CollectionView>
</ContentPage>