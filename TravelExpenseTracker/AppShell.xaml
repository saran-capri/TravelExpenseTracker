<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TravelExpenseTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TravelExpenseTracker"
    xmlns:pages="clr-namespace:TravelExpenseTracker.Pages"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="{StaticResource Primary}"
    Shell.TabBarForegroundColor="Black"
    Shell.TabBarTitleColor="#FF175CC4"
    Shell.TitleColor="White"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="Black"
    Title="TravelExpenseTracker">

    <!-- <Shell.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{StaticResource Primary}"/>
    </Shell.Behaviors> -->

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="LoginPage" />
    <TabBar>
        <ShellContent
            Title="Home"
            Icon="home.png"
            ContentTemplate="{DataTemplate pages:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="Trips"
            Icon="trip.png"
            ContentTemplate="{DataTemplate pages:TripsPage}"
            Route="TripsPage" />
        <ShellContent
            Title="Add Trip"
            Icon="add_trip.png"
            ContentTemplate="{DataTemplate pages:MainPage}"
            Route="MainPage2" />
        <ShellContent
            Title="Settings"
            Icon="settings.png"
            ContentTemplate="{DataTemplate pages:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>

</Shell>
